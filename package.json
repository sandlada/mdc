{
    "name": "sandlada-mdc-workspace",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w @sandlada/mdc",
        "build:dts": "npm run build:dts -w @sandlada/mdc",
        "dev": "npm run dev -w @sandlada/mdc-dev",
        "build:dev": "npm run build -w @sandlada/mdc-dev",
        "preview:dev": "npm run preview -w @sandlada/mdc-dev",
        "dev:docs": "npm run dev -w @sandlada/mdc-docs",
        "build:docs": "npm run build -w @sandlada/mdc-docs",
        "preview:docs": "npm run preview -w @sandlada/mdc-docs",
        "test": "npm run test -w @sandlada/mdc",
        "test:all": "npm run test -w @sandlada/mdc && npm run test -w @sandlada/mdc-dev --if-present",
        "build:all": "npm run build -w @sandlada/mdc && npm run build -w @sandlada/mdc-dev",
        "build:dts:all": "npm run build:dts -w @sandlada/mdc && npm run build:dts -w @sandlada/mdc-dev --if-present"
    },
    "devDependencies": {
        "typescript": "~7.0.2",
        "wrangler": "^4.148.0"
    }
}
