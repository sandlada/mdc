{
    "name": "sandlada-mdc-workspace",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "scripts": {
        "build": "pnpm --filter @sandlada/mdc run build",
        "build:dts": "pnpm --filter @sandlada/mdc run build:dts",
        "dev": "pnpm --filter @sandlada/dev-app run dev",
        "build:dev": "pnpm --filter @sandlada/dev-app run build",
        "preview:dev": "pnpm --filter @sandlada/dev-app run preview",
        "dev:docs": "pnpm --filter @sandlada/mdc-docs run dev",
        "build:docs": "pnpm --filter @sandlada/mdc-docs run build",
        "preview:docs": "pnpm --filter @sandlada/mdc-docs run preview",
        "test": "pnpm --filter @sandlada/mdc run test",
        "test:all": "pnpm --filter @sandlada/mdc run test && pnpm --filter @sandlada/dev-app run --if-present test",
        "build:all": "pnpm --filter @sandlada/mdc run build && pnpm --filter @sandlada/dev-app run build",
        "build:dts:all": "pnpm --filter @sandlada/mdc run build:dts && pnpm --filter @sandlada/dev-app run --if-present build:dts"
    },
    "devDependencies": {
        "typescript": "~7.0.2",
        "wrangler": "^4.151.2"
    }
}
