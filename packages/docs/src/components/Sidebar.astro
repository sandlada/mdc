---
/**
 * Component navigation, grouped into Base Components and Components.
 */
import { BaseComponents, ComponentGroupByName, ComponentNavigation } from '../lib/registry';

interface Props {
    active?: string;
}

const { active } = Astro.props;
const activeGroupId = active ? ComponentGroupByName.get(active)?.id : undefined;
---

<nav class="drawer open quick" id="drawer">
    <div class="scrollable">
        <mdc-elevation></mdc-elevation>
        <div class="content">
            <div class="group">
                <a class="tab" href={`/get-started/`} aria-current={active === 'get-started' ? 'page' : undefined}>
                    <span>Get Started</span>
                    <mdc-ripple></mdc-ripple>
                    <mdc-focus-ring></mdc-focus-ring>
                </a>
                <a class="tab" href={`/playground/`} aria-current={active === 'playground' ? 'page' : undefined}>
                    <span>Playground</span>
                    <mdc-ripple></mdc-ripple>
                    <mdc-focus-ring></mdc-focus-ring>
                </a>
                <a class="tab" href={`/for-ai/`} aria-current={active === 'for-ai' ? 'page' : undefined}>
                    <span>For AI</span>
                    <mdc-ripple></mdc-ripple>
                    <mdc-focus-ring></mdc-focus-ring>
                </a>
            </div>
            <div class="group">
                <mdc-divider inset class="group-divider"></mdc-divider>
                <h3 class="header">Base Components</h3>
                {BaseComponents.map((entry) => (
                    <a class="tab" href={`/components/${entry.name}/`} aria-current={active === entry.name ? 'page' : undefined}>
                        <span class="label">{entry.label}</span>
                        <mdc-ripple />
                        <mdc-focus-ring />
                    </a>
                ))}
            </div>
            <div class="group">
                <mdc-divider inset class="group-divider"></mdc-divider>
                <h3 class="header">Components</h3>
                {ComponentNavigation.map((item) => {
                    if ('entries' in item) {
                        const open = activeGroupId === item.id;
                        const linksId = `group-${item.id}`;
                        return (
                            <>
                                <button type="button" class="tab group-toggle" aria-expanded={open ? 'true' : 'false'} aria-controls={linksId}>
                                    <span class="label">{item.label}</span>
                                    <mdc-ripple />
                                    <mdc-focus-ring />
                                </button>
                                <div id={linksId} class="group-links" hidden={!open}>
                                    {item.entries.map((entry) => (
                                        <a class="tab" href={`/components/${entry.name}/`} aria-current={active === entry.name ? 'page' : undefined}>
                                            <span class="label">{entry.label}</span>
                                            <mdc-ripple />
                                            <mdc-focus-ring />
                                        </a>
                                    ))}
                                </div>
                            </>
                        );
                    }
                    return (
                        <a class="tab" href={`/components/${item.name}/`} aria-current={active === item.name ? 'page' : undefined}>
                            <span class="label">{item.label}</span>
                            <mdc-ripple />
                            <mdc-focus-ring />
                        </a>
                    );
                })}
            </div>
        </div>
    </div>
</nav>
<span class="scrim" aria-hidden="true"></span>

<script>
    import { inject } from '@sandlada/document-context';

    const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);

    const syncActiveSidebarLink = (drawerEl: HTMLElement) => {
        const currentPath = normalizePath(window.location.pathname);

        drawerEl.querySelectorAll<HTMLAnchorElement>('a.tab').forEach((link) => {
            const linkPath = normalizePath(new URL(link.href, window.location.origin).pathname);
            if (linkPath === currentPath) {
                link.setAttribute('aria-current', 'page');
                const groupPanel = link.parentElement;
                if (groupPanel?.classList.contains('group-links') && groupPanel.hidden) {
                    groupPanel.hidden = false;
                    const toggle = drawerEl.querySelector<HTMLButtonElement>(`.group-toggle[aria-controls="${groupPanel.id}"]`);
                    toggle?.setAttribute('aria-expanded', 'true');
                }
            } else {
                link.removeAttribute('aria-current');
            }
        });
    };

    const initSidebar = () => {
        const drawerEl = document.querySelector<HTMLElement>('#drawer');
        if (!drawerEl) return;

        const drawer = inject('drawer:session')(document.documentElement);

        syncActiveSidebarLink(drawerEl);

        // 移动端抽屉打开时点击导航跳转后自动收起
        if (drawer.value.isModal && drawer.value.isOpen) {
            drawer.update(() => ({ isOpen: false }));
        }

        if (drawerEl.dataset.bound === 'true') return;
        drawerEl.dataset.bound = 'true';

        drawerEl.querySelectorAll<HTMLButtonElement>('.group-toggle').forEach((btn) => {
            btn.addEventListener('click', () => {
                const expanded = btn.getAttribute('aria-expanded') === 'true';
                const next = !expanded;
                btn.setAttribute('aria-expanded', String(next));
                const controlsId = btn.getAttribute('aria-controls');
                if (controlsId) {
                    const panel = document.getElementById(controlsId);
                    if (panel) {
                        panel.hidden = !next;
                    }
                }
            });
        });

        const observer = inject('breakpoint:observer')(document.documentElement);

        let lastIsModal: boolean | null = null;
        let breakpointSynced = false;
        const clearQuick = () => drawer.update(() => ({ iSQuick: false }));
        const clearQuickAfterPaint = () => requestAnimationFrame(() => requestAnimationFrame(clearQuick));
        const tryClearQuick = () => {
            if (!breakpointSynced) return;
            if (document.readyState !== 'complete') return;
            clearQuickAfterPaint();
        };

        const unsubBreakpoint = observer.activeWidthBreakpoints$.subscribe((breakpoints) => {
            if (!drawerEl.isConnected) {
                unsubBreakpoint();
                return;
            }
            const nextIsModal = breakpoints.includes('compact') || breakpoints.includes('medium');
            if (nextIsModal === lastIsModal) return;
            lastIsModal = nextIsModal;
            drawer.update(() => ({ isModal: nextIsModal, isOpen: !nextIsModal }));
            breakpointSynced = true;
            tryClearQuick();
        });

        const unsubDrawer = drawer.subscribe((state) => {
            if (!drawerEl.isConnected) {
                unsubDrawer();
                return;
            }
            drawerEl.classList.toggle('modal', state.isModal);
            drawerEl.classList.toggle('open', state.isOpen);
            drawerEl.classList.toggle('quick', state.iSQuick);
        });

        const scrim = document.querySelector<HTMLElement>('#drawer+.scrim');
        scrim?.addEventListener('click', () => {
            drawer.update(() => ({ isOpen: false }));
        });

        if (document.readyState === 'complete') {
            tryClearQuick();
        } else {
            window.addEventListener('load', tryClearQuick, { once: true });
        }
    };

    document.addEventListener('astro:page-load', initSidebar);
</script>

<style>
    .drawer {
        position: relative;
        z-index: 1;
        transition-property: transform, display;
        transition-behavior: allow-discrete;

        &.modal {
            z-index: 1;
            position: fixed;
            inset: 0;
            height: 100dvh;
            max-height: 100dvh;
            width: min(360px, 72dvw);

            transition-property: transform, display;
            transition-behavior: allow-discrete;
        }
        &.modal:not(.open) {
            display: none;
            transition-duration: 250ms;
            transition-timing-function: var(--md-sys-motion-easing-emphasized);
            transform: translateX(-100%);
        }
        &.modal.open {
            display: flex;
            transition-duration: 500ms;
            transform: translateX(0%);
            transition-timing-function: var(--md-sys-motion-easing-emphasized-decelerate);
        }

        &:not(.modal.open) {
            display: none;
            width: var(--sidebar-width, 280px);
            transition-duration: 250ms;
            transition-timing-function: var(--md-sys-motion-easing-emphasized);
            transform: translateX(-100%);
        }
        &:not(.modal).open {
            display: block;
            width: var(--sidebar-width, 280px);
            transition-duration: 500ms;
            transition-timing-function: var(--md-sys-motion-easing-emphasized-decelerate);
            transform: translateX(0%);
        }
    }

    @starting-style {
        .drawer.modal.open {
            transform: translateX(-100%);
        }
        .drawer:not(.modal).open {
            transform: translateX(-100%);
        }
    }

    /* 首屏 quick 状态：直接渲染，不跑任何过渡；JS 在 load 后移除 .quick 恢复动效 */
    .drawer.quick,
    .drawer.quick .content,
    .drawer.quick + .scrim {
        transition: none !important;
    }

    /* SSR 无法感知视口，默认直出 open；在 modal 视口（<840px = compact/medium，与
       DEFAULT_WIDTH_BREAKPOINTS 一致）首屏就按“已关闭”直出，避免先画出 open 再被 JS
       关闭的闪现。JS 接管后 .quick 移除，此规则自然失效。 */
    @media (width < 840px) {
        .drawer.quick:not(.modal.open) {
            display: none;
        }
    }

    .scrim {
        z-index: 0;
        position: fixed;
        display: none;
        inset: 0;
        background: var(--md-sys-color-scrim);
        opacity: 0;
        user-select: none;
        pointer-events: none;
        width: 100dvw;
        height: 100dvh;

        transition-property: opacity, display;
        transition-duration: 250ms;
        transition-behavior: allow-discrete;
    }

    .drawer.modal.open + .scrim {
        display: flex;
        opacity: 0.38;
        pointer-events: auto;
        transition-duration: 500ms;
    }

    @starting-style {
        .drawer.modal.open + .scrim {
            opacity: 0;
        }
    }

    .scrollable {
        z-index: 1;
        display: flex;
        flex-direction: column;
        border-start-start-radius: 0px;
        border-end-start-radius: 0px;
        border-start-end-radius: var(--md-sys-shape-corner-value-large-increased);
        border-end-end-radius: var(--md-sys-shape-corner-value-large-increased);
        background: var(--md-sys-color-surface);
        overflow: auto;
        height: 100%;
        width: 100%;
    }

    .content {
        opacity: 0;
        transform: translateX(-48px);

        transition-property: opacity, transform;
    }
    .drawer.open .content {
        transition-duration: 500ms;
        transition-delay: 50ms;
        transform: translateX(0px);
        opacity: 1;
    }
    .drawer:not(.open) .content {
        transition-duration: 100ms;
        transform: translateX(-48px);
        opacity: 0;
    }
    @starting-style {
        .drawer.open .content {
            transform: translateX(-48px);
            opacity: 0;
        }
        .drawer:not(.open) .content {
            transform: translateX(0px);
            opacity: 1;
        }
    }
    .drawer.modal.open {
        --mdc-elevation-level: 3;
    }

    .group-header {
        position: sticky;
        top: 0;
    }
</style>

<style>
    @reference "../styles/global.css";
    .group {
        display: flex;
        flex-direction: column;
    }
    .group:first-child {
        margin-block-start: 24px;
    }
    .group:last-child {
        margin-block-end: 48px;
    }

    .group-divider {
        margin-block-start: 16px;
    }

    .header {
        @apply label-small;
        padding-inline: 32px 16px;
        margin-block-start: 24px;
        margin-block-end: 8px;
        color: var(--md-sys-color-on-surface-variant);
    }

    .group-divider + .header {
        margin-block-start: 16px;
    }

    .group-toggle {
        background: none;
        border: none;
        cursor: pointer;
        text-align: start;
        user-select: none;
    }
    .group-toggle::before {
        content: '';
        position: absolute;
        inset-inline-start: 16px;
        inset-block: 0;
        margin-block: auto;
        inline-size: 8px;
        block-size: 6px;
        background-color: currentColor;
        clip-path: polygon(0 0, 50% 60%, 100% 0, 100% 35%, 50% 100%, 0 35%);
        rotate: -90deg;
        transition: rotate 200ms cubic-bezier(0.2, 0, 0, 1);
    }
    .group-toggle:dir(rtl)::before {
        rotate: 90deg;
    }
    .group-toggle[aria-expanded='true']::before {
        rotate: 0deg;
    }
    @media (prefers-reduced-motion: reduce) {
        .group-toggle::before {
            transition: none;
        }
    }
    .group-links:not([hidden]) {
        display: flex;
        flex-direction: column;
    }

    .tab {
        @apply body-medium;
        position: relative;
        display: inline-flex;
        align-items: center;
        height: 40px;
        padding-inline: 32px 16px;
        margin-inline-end: 16px;
        border-start-start-radius: 0px;
        border-start-end-radius: 20px;
        border-end-start-radius: 0px;
        border-end-end-radius: 20px;
        color: var(--md-sys-color-on-surface);

        & > .label {
            overflow: hidden;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 1;
        }

        &[aria-current='page'] {
            font-weight: 700;
            background: var(--md-sys-color-primary);
            color: var(--md-sys-color-on-primary);
            --mdc-ripple-hovered-color: transparent;
            --mdc-ripple-pressed-color: transparent;
            --mdc-ripple-focused-color: transparent;
        }
    }
</style>
