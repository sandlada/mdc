---
/**
 * Base document shell: <head>, site header and the shared client bundle that
 * registers the library and the demo viewer.
 */
import '@fontsource-variable/google-sans-code';
import '../styles/global.css';
import '../styles/shiki.css';

interface Props {
    title: string;
    description: string;
    /** Path starting with `/`, used to derive the canonical URL. */
    path?: string;
    canonical?: string;
    robots?: string;
    keywords?: string[];
    author?: string;
    ogType?: 'website' | 'article';
    ogImage?: string;
    ogImageAlt?: string;
    twitterCard?: string;
    /** Extra structured-data blocks appended after the primary `jsonLd`. */
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
    extraJsonLd?: Array<Record<string, unknown>>;
}

const {
    title,
    description,
    path = '/',
    canonical: canonicalOverride,
    robots = 'index, follow',
    keywords = [],
    author = 'Sandlada',
    ogType = 'website',
    ogImage = 'https://mdc.sandlada.com/mdc-cover.png',
    ogImageAlt = 'MDC by Sandlada — Material Design 3 web components for any framework',
    twitterCard = 'summary_large_image',
    jsonLd,
    extraJsonLd = [],
} = Astro.props;

const normalizePath = (value: string) => (value.startsWith('/') ? value : `/${value}`);
const withTrailingSlash = (value: string) => (value.endsWith('/') ? value : `${value}/`);
const canonical = canonicalOverride ?? `https://mdc.sandlada.com${withTrailingSlash(normalizePath(path))}`;
const jsonLdBlocks = [...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []), ...extraJsonLd];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="robots" content={robots} />
        {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
        <meta name="author" content={author} />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#131316" media="(prefers-color-scheme: dark)" />
        <meta name="color-scheme" content="light dark" />
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="MDC by Sandlada" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1280" />
        <meta property="og:image:height" content="640" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content={twitterCard} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        {jsonLdBlocks.map((block) => (
            <script type="application/ld+json" set:html={JSON.stringify(block)} />
        ))}
        <slot name="head" />

        <!-- Init Sessions -->
        <script>
            import { inject } from '@sandlada/document-context';
            import { getBreakpointObserver, mountMainSession } from '../sessions';

            // 单一主 session 挂载到 documentElement，子 session 以 scoped provider
            // 形式暴露，消费者通过 inject('...:session') 解析。
            document.__mainSession = mountMainSession(document.documentElement);

            // 完整性自检：确保 provider 响应器已挂载（inject.js 的 mount 插件必须在挂载前求值，
            // 否则按需分包后会出现 UnknownServiceError）。同时把 inject.js 留在当前 chunk 内。
            if (inject('breakpoint:observer')(document.documentElement) !== getBreakpointObserver()) {
                throw new Error('breakpoint:observer provider mismatch');
            }

            // Init theme
            const theme = inject('theme:session')(document.documentElement);
            theme.subscribe((state) => {
                document.documentElement.toggleAttribute('dark', state.isDark);
            });
        </script>
    </head>
    <body>
        <slot />
        <script>
            import '../scripts/theme';
            import '../scripts/base-imports';
            import '../scripts/demo-viewer';
        </script>
    </body>
</html>
