---
import Docs from '../../layouts/Docs.astro'
import ComponentTabs from '../../components/ComponentTabs.astro'
import DemoPreview from '../../components/DemoPreview.astro'
import { components, getComponent, getDemo, listDemos, demoLabel } from '../../lib/registry'
import { breadcrumbJsonLd, componentDescription, excerptFromHtml } from '../../lib/seo'

interface Props {
    name: string
}

export function getStaticPaths() {
    return components.map((entry) => ({
        params: { name: entry.name },
        props: { name: entry.name },
    }))
}

const { name } = Astro.props
const entry = getComponent(name)

if (!entry) {
    throw new Error(`Unknown component: ${name}`)
}

const demos = listDemos(name)
const tag = `mdc-${name}`
const excerpt = excerptFromHtml(entry.readmeHtml)
const title = `${entry.label} Component (<${tag}>) · MDC Material Design 3`
const description = componentDescription(entry.label, tag, excerpt, demos.length)
const path = `/components/${name}/`
const keywords = [
    `${entry.label} web component`,
    tag,
    `Material Design 3 ${entry.label.toLowerCase()}`,
    '@sandlada/mdc',
    ...demos.map((file) => `${entry.label} ${demoLabel(file)}`.toLowerCase()),
]
const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: title,
        description,
        url: `https://mdc.sandlada.com/components/${name}/`,
        author: { '@type': 'Organization', name: 'Sandlada' },
        about: `${entry.label} (${tag}) Material Design 3 web component: live demos, API reference, and usage examples.`,
    },
    breadcrumbJsonLd([
        { name: 'Home', path: '/' },
        { name: entry.label, path },
    ]),
]
---

<Docs
    title={title}
    description={description}
    path={path}
    keywords={keywords}
    ogType="article"
    jsonLd={jsonLd}
    active={name}
>
    <h1 class="page-title">{entry.label}</h1>
    <ComponentTabs hasReadme={Boolean(entry.readmeHtml)}>
        {entry.readmeHtml && <div slot="readme" class="prose" set:html={entry.readmeHtml} />}
        <Fragment slot="demo">
            {
                demos.map((file) => (
                    <section class="demo-section">
                        <h2>{demoLabel(file)}</h2>
                        <DemoPreview html={getDemo(name, file)} />
                    </section>
                ))
            }
        </Fragment>
    </ComponentTabs>
</Docs>

<style>
    /* The tab panel already supplies top spacing — drop the first demo's. */
    .demo-section:first-child h2 {
        margin-block-start: 0;
    }
</style>
